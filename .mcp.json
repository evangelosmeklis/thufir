{
  "mcpServers": {
    "prometheus": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-servers/prometheus/server.py"],
      "env": {
        "PROMETHEUS_URL": "${PROMETHEUS_URL}",
        "PROMETHEUS_TOKEN": "${PROMETHEUS_TOKEN}"
      },
      "description": "Prometheus metrics and alerting integration"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub repository and issue integration (official MCP server)"
    },
    "gitlab": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-servers/gitlab/server.py"],
      "env": {
        "GITLAB_URL": "${GITLAB_URL:-https://gitlab.com}",
        "GITLAB_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_PROJECT_ID": "${GITLAB_PROJECT_ID}"
      },
      "description": "GitLab project and issue integration"
    }
  }
}
